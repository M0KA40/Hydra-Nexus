<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="920" Height="710" MinWidth="740" MinHeight="540" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen" Title="Hydra Nexus" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Window.Resources>
  <SolidColorBrush x:Key="Text" Color="#F0F8F5"/>
  <SolidColorBrush x:Key="Muted" Color="#AABDB9"/>
  <SolidColorBrush x:Key="Accent" Color="#AEF5D6"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent" Margin="2,0"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb MinHeight="32"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" CornerRadius="3" Background="#647E73" Margin="0,2"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#9CCBB5"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#AEF5D6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="#527467"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton x:Name="SelectorToggle" Focusable="False" BorderBrush="{TemplateBinding BorderBrush}" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ComboShell" Background="#142A22" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions><TextBlock Text="{Binding SelectionBoxItem,RelativeSource={RelativeSource AncestorType=ComboBox}}" Foreground="#F0F8F5"/><Path Grid.Column="1" x:Name="Chevron" Data="M0,0 L5,5 L10,0" Stroke="#AEF5D6" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin=".5,.5"><Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform></Path></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboShell" Property="BorderBrush" Value="#AEF5D6"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="ComboShell" Property="Background" Value="#1D382B"/><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="None" AllowsTransparency="True" Focusable="False">
     <Border x:Name="DropdownPanel" CornerRadius="12" BorderBrush="#638C79" BorderThickness="1" Padding="6" Margin="0,6,0,12" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}">
      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#273F34" Offset="0"/><GradientStop Color="#172D24" Offset="1"/></LinearGradientBrush></Border.Background>
      <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity=".35"/></Border.Effect>
      <ScrollViewer MaxHeight="240" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
     </Border>
    </Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#AEF5D6"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="#F0F8F5"/><Setter Property="Padding" Value="12"/><Setter Property="MinHeight" Value="42"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemShell" Padding="{TemplateBinding Padding}" CornerRadius="7" Margin="0,2" Background="Transparent"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Content,RelativeSource={RelativeSource TemplatedParent}}" Foreground="#F0F8F5" VerticalAlignment="Center"/><Path x:Name="SelectedMark" Grid.Column="1" Data="M0,5 L4,9 L11,1" Stroke="#AEF5D6" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemShell" Property="Background" Value="#3B5D4D"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemShell" Property="Background" Value="#345447"/><Setter TargetName="SelectedMark" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   </Style></Setter.Value></Setter>
  </Style>
  <Style x:Key="Chrome" TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="9"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#2D4440"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="Background" Value="#3A5750"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value=".6"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ActionButton" TargetType="Button">
   <Setter Property="Foreground" Value="#10271E"/><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Padding" Value="24,12"/><Setter Property="MinHeight" Value="44"/><Setter Property="MinWidth" Value="120"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" TextAlignment="Center" MaxWidth="210"/></DataTemplate></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Opacity" Value=".88"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value=".7"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="White"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border Margin="12" CornerRadius="20" BorderThickness="1" BorderBrush="#49605A">
  <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity=".35"/></Border.Effect>
  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#243B36" Offset="0"/><GradientStop Color="#101C1C" Offset=".46"/><GradientStop Color="#14231F" Offset="1"/></LinearGradientBrush></Border.Background>
  <Grid Margin="28,20,28,24">
   <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel x:Name="DragArea" Background="Transparent" Orientation="Horizontal"><Image x:Name="Logo" Width="38" Height="38" Margin="0,0,12,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="HYDRA NEXUS" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="EXTEND THE EXPERIENCE" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/></StackPanel></StackPanel>
    <Border Grid.Column="1" CornerRadius="8" BorderBrush="#3C564E" BorderThickness="1" Background="#192F29" Padding="10,6" VerticalAlignment="Center"><TextBlock x:Name="Version" Foreground="{StaticResource Accent}" FontSize="11"/></Border>
    <Button Grid.Column="3" x:Name="Minimize" Style="{StaticResource Chrome}"><Path Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Data="M0,5 L10,5"/></Button>
    <Button Grid.Column="4" x:Name="Dismiss" Style="{StaticResource Chrome}"><Path Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Data="M0,0 L9,9 M9,0 L0,9"/></Button>
   </Grid>
   <Grid x:Name="BodyArea" Grid.Row="1" Margin="0,18,0,18">
    <StackPanel x:Name="Body">
     <TextBlock x:Name="Eyebrow" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <TextBlock x:Name="Title" FontSize="30" FontWeight="SemiBold"/>
     <TextBlock x:Name="Hint" Foreground="{StaticResource Muted}" FontSize="14" LineHeight="23" Margin="0,8,0,18"/>
     <UniformGrid x:Name="Steps" Columns="3" Margin="-3,0,-3,20">
      <Border x:Name="StepShell0" CornerRadius="8" Margin="3" Padding="10" Background="#1C302B"><TextBlock x:Name="StepText0" FontSize="11"/></Border>
      <Border x:Name="StepShell1" CornerRadius="8" Margin="3" Padding="10" Background="#1C302B"><TextBlock x:Name="StepText1" FontSize="11"/></Border>
      <Border x:Name="StepShell2" CornerRadius="8" Margin="3" Padding="10" Background="#1C302B"><TextBlock x:Name="StepText2" FontSize="11"/></Border>
      <Border x:Name="StepShell3" CornerRadius="8" Margin="3" Padding="10" Background="#1C302B"><TextBlock x:Name="StepText3" FontSize="11"/></Border>
      <Border x:Name="StepShell4" CornerRadius="8" Margin="3" Padding="10" Background="#1C302B"><TextBlock x:Name="StepText4" FontSize="11"/></Border>
      <Border x:Name="StepShell5" CornerRadius="8" Margin="3" Padding="10" Background="#1C302B"><TextBlock x:Name="StepText5" FontSize="11"/></Border>
     </UniformGrid>
     <StackPanel x:Name="SetupOptions" Visibility="Collapsed" Margin="0,0,0,20">
      <TextBlock x:Name="FolderLabel" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Folder" AutomationProperties.Name="Hydra folder" Background="#0E1D19" Foreground="#E4F4EE" BorderBrush="#527467" Padding="10" MinWidth="0" VerticalContentAlignment="Center" FlowDirection="LeftToRight"/><Button x:Name="Browse" Grid.Column="1" Style="{StaticResource ActionButton}" Background="#29453B" Foreground="#DAF1E7" Margin="8,0,0,0" Padding="14,8" MinWidth="80"/></Grid>
      <TextBlock x:Name="OperationLabel" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,14,0,8"/><ComboBox x:Name="Operation" MinHeight="36" Padding="8" Foreground="{StaticResource Text}"/>
     </StackPanel>
     <Border x:Name="ProgressPanel" CornerRadius="14" BorderBrush="#3E594F" BorderThickness="1" Padding="18" Background="#B012241E">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" FontWeight="SemiBold" FontSize="16" Margin="0,0,12,16"/><TextBlock x:Name="Step" Grid.Column="1" Foreground="{StaticResource Accent}" FontFamily="Consolas" FontSize="12" FlowDirection="LeftToRight"/></Grid>
       <Border Grid.Row="1" Background="#31493F" CornerRadius="4"><Canvas x:Name="Track" ClipToBounds="True" Height="8"><Rectangle x:Name="Bar" Height="8" Width="210" RadiusX="4" RadiusY="4" Fill="{StaticResource Accent}"><Rectangle.RenderTransform><TranslateTransform x:Name="Motion" X="-210"/></Rectangle.RenderTransform></Rectangle></Canvas></Border>
       <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SmallStatus" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Grid.Column="1" x:Name="Elapsed" Foreground="{StaticResource Muted}" FontSize="12" FontFamily="Consolas" FlowDirection="LeftToRight" Margin="12,0,0,0"/></Grid>
       <TextBlock x:Name="Footer" Grid.Row="3" Foreground="#F1C296" FontSize="12" Margin="0,12,0,0"/>
      </Grid>
     </Border>
     <Button x:Name="Details" Style="{StaticResource ActionButton}" Foreground="{StaticResource Muted}" Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Left" Padding="0,6" Margin="0,6,0,0" MinHeight="32"/>
     <TextBox x:Name="DetailText" Visibility="Collapsed"/>

    </StackPanel>
   </Grid>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Stroke="#AEF5D6" StrokeThickness="1.5" Data="M8,0 L15,3 L15,9 C15,14 8,18 8,18 C8,18 1,14 1,9 L1,3 Z M4,8 L7,11 L12,6" Width="18" Height="20" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Grid.Column="1" x:Name="Safety" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/></Grid><Button Grid.Column="2" x:Name="Action" Style="{StaticResource ActionButton}" VerticalAlignment="Center"/></Grid>
  </Grid>
 </Border>
</Window>
